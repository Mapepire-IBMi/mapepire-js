# WebSocket Mode Configuration (for daemon server)
# defaults to localhost
#VITE_SERVER=localhost

# defaults to 8076
#VITE_PORT=8076

# Use this to enable non-secure communications for testing.
#VITE_REJECT_UNAUTHORIZED=0

VITE_DB_USER=X
VITE_DB_PASS=X

# SSH Single Mode Configuration (for MCP server integration)
# IBM i host connection details
IBMI_HOST=your-ibmi-host.com
IBMI_USER=YOURUSER
IBMI_PASSWORD=yourpassword

# Path to mapepire-server JAR file on IBM i (optional)
# Defaults to the standard install location: /opt/mapepire/lib/mapepire/mapepire-server.jar
# Override only if installed to a non-standard location, e.g.:
#   - /home/YOURUSER/mapepire-server.jar
# To find it: ssh YOURUSER@your-ibmi-host.com "find /home /opt -name 'mapepire-server*.jar' 2>/dev/null"
#IBMI_SERVER_PATH=/home/YOURUSER/mapepire-server.jar

# Path to Java on IBM i (optional)
# Defaults to IBM Java 8 64-bit: /QOpenSys/QIBM/ProdData/JavaVM/jdk80/64bit/bin/java
# Other common locations:
#   - /QOpenSys/pkgs/bin/java (open-source Java from yum)
#   - /QOpenSys/QIBM/ProdData/JavaVM/jdk11/64bit/bin/java (IBM Java 11)
# To find it: ssh YOURUSER@your-ibmi-host.com "which java"
#IBMI_JAVA_PATH=/QOpenSys/pkgs/bin/java

# SSH Key Authentication (alternative to password)
# Uncomment and set these if using SSH key authentication
#IBMI_PRIVATE_KEY_PATH=/path/to/your/private/key
#IBMI_PASSPHRASE=your-key-passphrase-if-any

# Optional: SSH port (defaults to 22)
#IBMI_PORT=22