{
  "compilerOptions": {
		"module": "commonjs",
		"target": "ES2022",
		"noImplicitAny": false,
		"noUnusedParameters": false,
		"strict": false,
		"allowJs": true,
		"rootDir": "./",
		"outDir": "./dist",
		"esModuleInterop": true,
		"sourceMap": true,
		"declaration": true
	},
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "scripts"]
}
